        row = self.db.execute("SELECT completed FROM tasks WHERE id=?", (task_id,)).fetchone()
        if not row:
            return
        new_value = 0 if row["completed"] else 1
        with self.db:
            self.db.execute("UPDATE tasks SET completed=? WHERE id=?", (new_value, task_id))
        self.handle_ui_action("toggle_task", {"task_id": task_id, "completed": bool(new_value)})
        self.show_tasks()

    def remove_completed_tasks(self):
        count = self.db.execute("SELECT COUNT(*) FROM tasks WHERE completed=1").fetchone()[0]
        if count == 0:
            messagebox.showinfo("Remove completed", "There are no completed tasks to remove.", parent=self.root)
            return
        if messagebox.askyesno("Remove completed", f"Permanently remove {count} completed task(s)?", parent=self.root):
            with self.db:
                self.db.execute("DELETE FROM tasks WHERE completed=1")
            self.handle_ui_action("remove_completed_tasks", {"count": count})
            self.show_tasks()

    def quit_app(self):
        self.handle_ui_action("quit")
        try:
            self.db.close()
        finally:
            self.root.destroy()


class _RoutinaBridge:
    """Connect the original Routina window to shared settings and game services."""

    def __init__(self, owner):
        """Open the shared game database and attach theme observers."""
        self.owner = owner
        self.root = owner.root
        self.app_dir = Path(__file__).resolve().parent
        self.db = fc.open_database(self.app_dir)
        self.theme = self.db.load_theme()
        self.theme.set_flag("mute", self.db.get_config("mute", "0") == "1")
        self.theme.set_flag("reduce_motion", self.db.get_config("reduce_motion", "0") == "1")
        self.theme.subscribe(owner._apply_theme)
        self.game_ctx = None
        self.game_menu = None
        game_hooks.bind(self.db)
        self._bind_tasks()

    def _bind_tasks(self):
        """Reopen the original task connection at the selected database path."""
        try:
            self.owner.db.close()
        except Exception:
            pass
        self.owner.db = sqlite3.connect(self.db.path)
        self.owner.db.row_factory = sqlite3.Row
        game_hooks.bind(self.db)
        if hasattr(self.owner, "root") and self.owner.root.winfo_exists():
            self.owner.show_home()

    def open_game(self):
        """Open the existing game menu over the original Routina window."""
        if self.game_menu:
            return
        engine = gui.AnimEngine(self.root, self.theme)
        self.game_ctx = gui.GameCtx(self.root, self.theme, self.db, engine)
        self.game_ctx.audio = gui.AudioPlayer(self.theme)
        self.game_ctx.audio.play_theme("menu")
        self.game_menu = gui.GameMenu(self, self.game_ctx, self._game_closed)

    def _game_closed(self):
        """Return to the original Routina window after the game closes."""
        self.game_menu = None
        self.game_ctx = None
        self.root.deiconify()
        self.root.lift()

    def close(self):
        """Close the game and release its additional database connection."""
        if self.game_menu:
            self.game_menu.close()
        self.db.close()


def _skin_original(widget, theme):
    """Apply the shared theme to widgets in the original Routina screen."""
    try:
        if isinstance(widget, (tk.Frame, tk.Canvas)):
            widget.configure(bg=theme.background)
        elif isinstance(widget, tk.Label):
            widget.configure(bg=theme.background, fg=theme.text)
        elif isinstance(widget, tk.Button):
            widget.configure(bg=theme.button, fg=theme.accent,
                             activebackground=theme.panel, activeforeground=theme.text)
        elif isinstance(widget, tk.Scrollbar):
            widget.configure(bg=theme.panel, troughcolor=theme.background,
                             activebackground=theme.accent)
    except tk.TclError:
        pass
    for child in widget.winfo_children():
        _skin_original(child, theme)


