def _load_embedded_modules():
    """Create each embedded module in dependency order and register it in sys.modules."""
    for name in ("fortcore", "game_hooks", "game_ui", "routina_plus"):
        text = _MODULE_SOURCES[name]
        filename = "<%s>" % name
        linecache.cache[filename] = (len(text), None, text.splitlines(True), filename)
        module = types.ModuleType(name)
        module.__file__ = os.path.abspath(__file__)   # data files and the database live next to this file
        sys.modules[name] = module
        exec(compile(text, filename, "exec"), module.__dict__)
    return sys.modules["routina_plus"], sys.modules["fortcore"]


def main():
    """Launch Routina Plus (or run the built-in checks with --selftest)."""
    app_module, core = _load_embedded_modules()
    if "--selftest" in sys.argv:
        return 0 if core.run_all() else 1
    app_module.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
