class Database:
    """SQLite wrapper: WAL, explicit transactions, backup recovery."""

    VISIBLE_KEYS = ("chart_type", "mute", "reduce_motion", "theme_json", "data_path_note")

    def __init__(self, path, rng=None):
        """Open (and if needed recover) the database at path."""
        self.path = str(path)
        self.rng = rng or random.Random()
        self.last_warning = None
        self._depth = 0
        self.conn = self._open_with_recovery()
        self._init_schema()
        self.backup()

    def _connect(self, path=None):
        """Open one connection and verify integrity."""
        c = sqlite3.connect(path or self.path, timeout=5, isolation_level=None, check_same_thread=False)
        c.row_factory = sqlite3.Row
        try:
            c.execute("PRAGMA journal_mode=WAL")
            c.execute("PRAGMA synchronous=NORMAL")
            r = c.execute("PRAGMA integrity_check").fetchone()
            if r[0] != "ok":
                raise sqlite3.DatabaseError("integrity check failed")
        except Exception:
            c.close()
            raise
        return c

    def _open_with_recovery(self):
        """Connect; on corruption restore the backup copy, on lock use a backup copy; warn."""
        Path(self.path).parent.mkdir(parents=True, exist_ok=True)
        try:
            return self._connect()
        except sqlite3.Error as exc:
            msg = str(exc).lower()
            bak = self.path + ".bak"
            if "locked" in msg and os.path.exists(bak):
                alt = self.path + ".locked-copy.sqlite3"
                shutil.copy2(bak, alt)
                self.path = alt
                self.last_warning = "Database is locked; working on a backup copy instead: " + alt
                return self._connect()
            if any(w in msg for w in _CORRUPT_WORDS) and os.path.exists(bak):
                stamp = datetime.now().strftime("%Y%m%d%H%M%S")
                for suf in ("", "-wal", "-shm"):
                    if os.path.exists(self.path + suf):
                        try:
                            os.replace(self.path + suf, self.path + ".corrupt-" + stamp + suf)
                        except OSError:
                            pass
                shutil.copy2(bak, self.path)
                self.last_warning = "Database was corrupt; restored the latest backup copy."
                return self._connect()
            raise GameError("Cannot open database: %s" % exc)

    def _init_schema(self):
        """Create tables and seed rows."""
        with self.tx() as c:
            for stmt in SCHEMA.split(";\n"):
                if stmt.strip():
                    c.execute(stmt)
            cols = [r[1] for r in c.execute("PRAGMA table_info(reward_ledger)").fetchall()]
            if "pending" not in cols:
                c.execute("ALTER TABLE reward_ledger ADD COLUMN pending INT NOT NULL DEFAULT 0")
                # Old versions left cooldown-blocked completions at amount 0 forever; make them claimable.
                c.execute("UPDATE reward_ledger SET pending=1 WHERE amount=0 AND awarded_at IS NULL "
                          "AND completed_at NOT LIKE '%T00:00:00'")
            c.execute("INSERT OR IGNORE INTO tokens(id,balance,total_earned,total_spent) VALUES(1,0,0,0)")
            c.execute("INSERT OR IGNORE INTO config(key,value) VALUES(?,?)", (SECRET_KEY, "0"))
            c.execute("INSERT OR IGNORE INTO config(key,value) VALUES('chart_type','bar')")
            c.execute("""INSERT OR IGNORE INTO reward_ledger
                (activity_type,activity_id,completion_date,completed_at,amount,awarded_at)
                SELECT 'task',substr(task_key,1,instr(task_key,':')-1),
                       substr(task_key,instr(task_key,':')+1,10),awarded_at,1,awarded_at
                FROM awarded_tasks WHERE instr(task_key,':')>0""")
            c.execute("INSERT OR IGNORE INTO task_completions(task_id,completion_date) "
                      "SELECT id, substr(created_at,1,10) FROM tasks WHERE completed=1 AND id NOT IN "
                      "(SELECT task_id FROM task_completions)")
            c.execute("""INSERT OR IGNORE INTO reward_ledger
                (activity_type,activity_id,completion_date,completed_at,amount,awarded_at)
                SELECT 'task',CAST(task_id AS TEXT),completion_date,completion_date||'T00:00:00',0,NULL
                FROM task_completions""")
            if c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='habit_completions'").fetchone():
                c.execute("""INSERT OR IGNORE INTO reward_ledger
                    (activity_type,activity_id,completion_date,completed_at,amount,awarded_at)
                    SELECT 'habit',CAST(habit_id AS TEXT),completion_date,
                           completion_date||'T00:00:00',0,NULL
                    FROM habit_completions WHERE completed=1""")
            # The payout interval is stored in seconds. Convert settings saved by earlier builds.
            if c.execute("SELECT 1 FROM config WHERE key='reward_interval_seconds'").fetchone() is None:
                old = c.execute("SELECT value FROM config WHERE key='reward_interval_minutes'").fetchone()
                try:
                    seconds = max(0, min(MAX_REWARD_SECONDS, int(old[0]) * 60)) if old else DEFAULT_REWARD_SECONDS
                except (TypeError, ValueError):
                    seconds = DEFAULT_REWARD_SECONDS
                c.execute("INSERT INTO config(key,value) VALUES('reward_interval_seconds',?)", (str(seconds),))
            c.execute("DELETE FROM config WHERE key='reward_interval_minutes'")
            # Start the passive-income model without granting months of back pay.
            if c.execute("SELECT 1 FROM config WHERE key='reward_model_v2'").fetchone() is None:
                stamp = now()
                waiting = c.execute("SELECT COUNT(*) FROM reward_ledger WHERE pending=1").fetchone()[0]
                if waiting:
                    c.execute("UPDATE tokens SET balance=balance+?,total_earned=total_earned+? WHERE id=1",
                              (waiting * 10, waiting * 10))
                    c.execute("UPDATE config SET value=CAST(COALESCE(value,'0') AS INTEGER)+? WHERE key=?",
                              (waiting, SECRET_KEY))
                c.execute("UPDATE reward_ledger SET amount=amount+CASE WHEN pending=1 THEN 10 ELSE 0 END,"
                          "awarded_at=?,pending=0", (stamp,))
                c.execute("INSERT INTO config(key,value) VALUES('reward_model_v2','1')")

    @contextmanager
    def tx(self):
        """Run a block inside one transaction (re-entrant)."""
        if self._depth > 0:
            self._depth += 1
            try:
                yield self.conn
            finally:
                self._depth -= 1
            return
        self.conn.execute("BEGIN IMMEDIATE")
        self._depth = 1
        try:
            yield self.conn
            self.conn.execute("COMMIT")
        except BaseException:
            try:
                self.conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
            raise
        finally:
            self._depth = 0

    def get_config(self, key, default=None):
        """Read a config value."""
        r = self.conn.execute("SELECT value FROM config WHERE key=?", (key,)).fetchone()
        return r[0] if r else default

    def set_config(self, key, value) -> None:
        """Write a config value."""
        with self.tx() as c:
            c.execute("INSERT INTO config(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                      (key, str(value)))

    def visible_config(self):
        """Return config rows from the explicit whitelist only."""
        q = ",".join("?" for _ in self.VISIBLE_KEYS)
        return [tuple(r) for r in self.conn.execute(
            "SELECT key,value FROM config WHERE key IN (%s) ORDER BY key" % q, self.VISIBLE_KEYS)]

    def secret_total(self) -> int:
        """Return the hidden all-time completion counter."""
        return int(self.get_config(SECRET_KEY, "0") or 0)

    def award_task(self, task_key: str) -> bool:
        """Award +1 token once per task_key; returns False for duplicates."""
        with self.tx() as c:
            cur = c.execute("INSERT OR IGNORE INTO awarded_tasks(task_key,awarded_at) VALUES(?,?)", (task_key, now()))
            if cur.rowcount == 0:
                return False
            c.execute("UPDATE config SET value=CAST(COALESCE(value,'0') AS INTEGER)+1 WHERE key=?", (SECRET_KEY,))
            c.execute("UPDATE tokens SET balance=balance+1,total_earned=total_earned+1 WHERE id=1")
        return True

    def reward_interval_seconds(self) -> int:
        """Return the configured seconds between chest payouts (0 = no timer, pays on every claim)."""
        try:
            return max(0, min(MAX_REWARD_SECONDS, int(self.get_config("reward_interval_seconds",
                                                                      str(DEFAULT_REWARD_SECONDS)))))
        except (TypeError, ValueError):
            return DEFAULT_REWARD_SECONDS

    def income_stream_count(self) -> int:
        """Number of completed tasks/habits; each one is a recurring income stream."""
        return self.conn.execute("SELECT COUNT(*) FROM reward_ledger").fetchone()[0]

    def reward_rate(self) -> int:
        """Tokens paid per interval: grows with every task or habit completed."""
        return self.income_stream_count() * TOKENS_PER_STREAM

    def _claim_locked(self, c, now_dt, manual=False, live=False) -> int:
        """Pay accrued chest income. Every completed activity earns TOKENS_PER_STREAM per interval.

        interval > 0: each stream pays once per elapsed interval (time the app was closed is not paid).
        interval = 0: there is no timer. Automatic ticks only pay completions that were never paid;
                      a manual claim pays the full rate on every click.
        """
        interval = self.reward_interval_seconds()
        stamp = now_dt.isoformat(timespec="seconds")
        total = 0
        if interval == 0:
            where = "" if manual else "WHERE pending=1 "
            rows = c.execute("SELECT activity_type,activity_id,completion_date FROM reward_ledger " + where).fetchall()
            for row in rows:
                c.execute("UPDATE reward_ledger SET amount=amount+?,awarded_at=?,pending=0 "
                          "WHERE activity_type=? AND activity_id=? AND completion_date=?",
                          (TOKENS_PER_STREAM, stamp, row[0], row[1], row[2]))
                total += TOKENS_PER_STREAM
        else:
            downtime = 0.0
            if live:
                beat = self.get_config("reward_heartbeat")
                if beat:
                    try:
                        gap = (now_dt - datetime.fromisoformat(beat)).total_seconds()
                        if gap > DOWNTIME_GRACE_SECONDS:
                            downtime = gap
                    except ValueError:
                        pass
                c.execute("INSERT INTO config(key,value) VALUES('reward_heartbeat',?) "
                          "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (stamp,))
            rows = c.execute("SELECT activity_type,activity_id,completion_date,completed_at,awarded_at "
                             "FROM reward_ledger").fetchall()
            for row in rows:
                base = datetime.fromisoformat(row[4] or row[3])
                if downtime:
                    base += timedelta(seconds=min(downtime, max(0.0, (now_dt - base).total_seconds())))
                periods = max(0, int((now_dt - base).total_seconds() // interval))
                if periods == 0 and not downtime:
                    continue
                paid = periods * TOKENS_PER_STREAM
                last_paid = (base + timedelta(seconds=periods * interval)).isoformat(timespec="seconds")
                c.execute("UPDATE reward_ledger SET amount=amount+?,awarded_at=?,pending=CASE WHEN ?>0 THEN 0 ELSE pending END "
                          "WHERE activity_type=? AND activity_id=? AND completion_date=?",
                          (paid, last_paid, periods, row[0], row[1], row[2]))
                total += paid
        if total:
            c.execute("UPDATE tokens SET balance=balance+?,total_earned=total_earned+? WHERE id=1", (total, total))
        return total

    def claim_pending(self, now_dt=None, manual=False) -> int:
        """Pay whatever the timer says is due. Pass now_dt only for tests; omit it for the live clock."""
        live = now_dt is None
        with self.tx() as c:
            return self._claim_locked(c, now_dt or datetime.now(), manual=manual, live=live)

    def claim_all_now(self) -> int:
        """Manual 'Get tokens': pays what is due; with interval 0 every click pays the current rate."""
        return self.claim_pending(manual=True)

    def pending_count(self) -> int:
        """Number of completions that have not been paid even once yet."""
        return self.conn.execute("SELECT COUNT(*) FROM reward_ledger WHERE pending=1").fetchone()[0]

    def seconds_until_payout(self, now_dt=None):
        """Seconds until the next automatic payout, or None when there is no timer or no income."""
        interval = self.reward_interval_seconds()
        if interval == 0:
            return None
        now_dt = now_dt or datetime.now()
        best = None
        for completed, awarded in self.conn.execute("SELECT completed_at,awarded_at FROM reward_ledger").fetchall():
            due = (datetime.fromisoformat(awarded or completed) + timedelta(seconds=interval) - now_dt).total_seconds()
            best = due if best is None else min(best, due)
        return None if best is None else max(0, int(best + 0.999))

    def award_activity_completion(self, activity_type: str, activity_id, completed_at: str,
                                  schedule=None) -> int:
        """Record a unique completion that adds a recurring income stream."""
        if activity_type not in ("task", "habit"):
            return 0
        try:
            completion_time = datetime.fromisoformat(completed_at)
        except (TypeError, ValueError):
            return 0
        completion_date = completion_time.date().isoformat()
        if activity_type == "habit":
            weekday = completion_time.weekday()
            if schedule == "Weekdays" and weekday >= 5:
                return 0
            if schedule == "Weekends" and weekday < 5:
                return 0
            if schedule not in ("Every day", "Weekdays", "Weekends"):
                return 0
        with self.tx() as c:
            cur = c.execute("""INSERT OR IGNORE INTO reward_ledger
                (activity_type,activity_id,completion_date,completed_at,amount,awarded_at,pending)
                VALUES(?,?,?,?,0,NULL,1)""",
                (activity_type, str(activity_id), completion_date, completed_at))
            if cur.rowcount == 0:
                return 0
            c.execute("UPDATE config SET value=CAST(COALESCE(value,'0') AS INTEGER)+1 WHERE key=?", (SECRET_KEY,))
            if self.reward_interval_seconds() == 0:
                # No timer: the new completion pays its first reward right away (only that one).
                c.execute("UPDATE reward_ledger SET amount=?,awarded_at=?,pending=0 "
                          "WHERE activity_type=? AND activity_id=? AND completion_date=?",
                          (TOKENS_PER_STREAM, completed_at, activity_type, str(activity_id), completion_date))
                c.execute("UPDATE tokens SET balance=balance+?,total_earned=total_earned+? WHERE id=1",
                          (TOKENS_PER_STREAM, TOKENS_PER_STREAM))
                return TOKENS_PER_STREAM
            return 0

    def set_reward_interval_seconds(self, seconds) -> None:
        """Persist the chest payout interval in seconds (0 = no timer)."""
        msg = "Enter a whole number of seconds from 0 to %d (0 = no timer, every claim pays)." % MAX_REWARD_SECONDS
        try:
            value = int(str(seconds).strip())
        except (TypeError, ValueError):
            raise ValueError(msg)
        if not 0 <= value <= MAX_REWARD_SECONDS:
            raise ValueError(msg)
        previous = self.reward_interval_seconds()
        if value == previous:
            return
        self.claim_pending()            # settle everything earned under the old interval first
        stamp = now()
        with self.tx() as c:
            c.execute("INSERT INTO config(key,value) VALUES('reward_interval_seconds',?) "
                      "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (str(value),))
            c.execute("UPDATE reward_ledger SET awarded_at=?,pending=0", (stamp,))

    def add_tokens(self, n: int) -> None:
        """Add tokens (counted as earned)."""
        with self.tx() as c:
            c.execute("UPDATE tokens SET balance=balance+?,total_earned=total_earned+? WHERE id=1", (n, n))

    def balance(self) -> dict:
        """Return the token row as a dict."""
        return dict(self.conn.execute("SELECT balance,total_earned,total_spent FROM tokens WHERE id=1").fetchone())

    def spend(self, amount: int) -> bool:
        """Spend tokens atomically; False if insufficient."""
        with self.tx() as c:
            bal = c.execute("SELECT balance FROM tokens WHERE id=1").fetchone()[0]
            if bal < amount:
                return False
            c.execute("UPDATE tokens SET balance=balance-?,total_spent=total_spent+? WHERE id=1", (amount, amount))
        return True

    def log(self, event_type, enemy_id=None, unit_id=None, fortress_id=None, details="") -> None:
        """Append a history_log row."""
        with self.tx() as c:
            c.execute("INSERT INTO history_log(ts,event_type,enemy_id,unit_id,fortress_id,details) VALUES(?,?,?,?,?,?)",
                      (now(), event_type, enemy_id, unit_id, fortress_id, details))

    def save_theme(self, theme: Theme) -> None:
        """Persist theme colours and flags."""
        with self.tx():
            self.set_config("theme_json", theme.to_json())
            self.set_config("mute", int(theme.mute))
            self.set_config("reduce_motion", int(theme.reduce_motion))

    def load_theme(self) -> Theme:
        """Restore the saved theme (defaults if none)."""
        return Theme.from_json(self.get_config("theme_json", ""), self.get_config("mute", "0") == "1",
                               self.get_config("reduce_motion", "0") == "1")

    def backup(self):
        """Write a .bak copy via the SQLite backup API; returns its path or None."""
        dst = None
        try:
            bak = self.path + ".bak"
            dst = sqlite3.connect(bak)
            self.conn.backup(dst)
            return bak
        except Exception:
            return None
        finally:
            if dst is not None:
                dst.close()

    def close(self) -> None:
        """Back up and close."""
        try:
            self.backup()
            self.conn.close()
        except Exception:
            pass


def valid_activity_name(name: str) -> bool:
    """Accept nonempty Unicode alphabetic words separated by ordinary spaces only."""
    if not isinstance(name, str):
        return False
    normalized = name.strip()
    return bool(normalized) and all(ch == " " or ch.isalpha() for ch in normalized)


def valid_task_name(name: str) -> bool:
    """Compatibility name for existing task-entry callers."""
    return valid_activity_name(name)


def db_file(directory) -> Path:
    """Return the database file path inside a directory."""
    return Path(directory) / DB_NAME


def load_bootstrap(app_dir):
    """Read the stored data path from the bootstrap JSON (or None)."""
    try:
        with open(Path(app_dir) / BOOTSTRAP_NAME, "r", encoding="utf-8") as f:
            p = json.load(f).get("data_path")
        return p if isinstance(p, str) and p else None
    except (OSError, ValueError, AttributeError):
        return None


def save_bootstrap(app_dir, data_path) -> bool:
    """Store only the data path in the bootstrap JSON; False if not writable."""
    try:
        with open(Path(app_dir) / BOOTSTRAP_NAME, "w", encoding="utf-8") as f:
            json.dump({"data_path": str(data_path)}, f)
        return True
    except OSError:
        return False


def validate_data_path(p) -> tuple:
    """Return (ok, message) for a candidate data folder."""
    try:
        if not p or not str(p).strip():
            return False, "path is empty"
        d = Path(str(p).strip())
        if not d.is_dir():
            return False, "folder does not exist"
        probe = d / (".write_test_%d" % os.getpid())
        with open(probe, "w") as f:
            f.write("x")
        probe.unlink()
        return True, "ok"
    except OSError as exc:
        return False, "not writable (%s)" % exc


def migrate_data(old_dir, new_dir) -> str:
    """Copy the database from old_dir to new_dir (existing target is kept as .bak)."""
    src, dst = db_file(old_dir), db_file(new_dir)
    if not src.exists() or src.resolve() == dst.resolve():
        return "nothing to migrate"
    if dst.exists():
        shutil.copy2(dst, str(dst) + ".premigrate.bak")
        dst.unlink()
    s = sqlite3.connect(str(src))
    d = sqlite3.connect(str(dst))
    try:
        s.backup(d)
    finally:
        d.close()
        s.close()
    return "migrated"


def open_database(app_dir, rng=None) -> Database:
    """Open the database at the bootstrap path, falling back to the app folder with a warning."""
    warn = None
    folder = str(app_dir)
    p = load_bootstrap(app_dir)
    if p:
        ok, msg = validate_data_path(p)
        if ok:
            folder = p
        else:
            warn = "Data path '%s' is invalid (%s); using the default location." % (p, msg)
    try:
        db = Database(db_file(folder), rng)
    except GameError:
        if folder == str(app_dir):
            raise
        db = Database(db_file(app_dir), rng)
        warn = (warn or "") + " Could not open the database at '%s'; using default." % folder
    if warn:
        db.last_warning = (warn + " " + (db.last_warning or "")).strip()
    return db


