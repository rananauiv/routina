def _clear_with_badge(self):
    """Clear the screen, then restore the token badge on top of the new one."""
    _base_clear(self)
    try:
        self.root.after(50, lambda: _update_badge(self))
    except tk.TclError:
        pass


def _claim_from_badge(self):
    """Badge click: Get tokens (interval 0 pays the full rate each click), then refresh the badge."""
    game_hooks.claim_all()
    _update_badge(self)


def _update_badge(self):
    """Show the live token balance (and waiting rewards) in the corner of every screen."""
    try:
        balance, _waiting = game_hooks.token_summary()
        rate, seconds = game_hooks.reward_info()
        if rate:
            text = "Tokens: %d  |  " % balance + ("click: +%d" % rate if seconds == 0 else "+%d / %ds" % (rate, seconds))
        else:
            text = "Tokens: %d" % balance
        badge = getattr(self, "_token_badge", None)
        if badge is None or not badge.winfo_exists():
            badge = tk.Button(self.root, bd=0, cursor="hand2", font=("Arial", 11, "bold"),
                              command=lambda: _claim_from_badge(self))
            self._token_badge = badge
        badge.configure(text=text, bg=BLACK, fg=GREEN, activebackground=CARD_BG, activeforeground=WHITE)
        badge.place(relx=1.0, x=-10, y=8, anchor="ne")
        badge.lift()
    except tk.TclError:
        pass


def _badge_loop(self):
    """Refresh the badge (and pay anything the interval now allows) once a second."""
    _update_badge(self)
    try:
        self.root.after(1000, lambda: _badge_loop(self))
    except tk.TclError:
        pass


def _integrated_init(self, root):
    """Initialize the untouched Routina UI, then attach Settings and game services."""
    _base_init(self, root)
    self.bridge = _RoutinaBridge(self)
    self.theme = self.bridge.theme
    self._apply_theme(self.theme)
    _badge_loop(self)


def _apply_theme(self, theme):
    """Restyle the current original Routina screen as theme values change."""
    global BLACK, WHITE, GREEN, GREEN_DARK, GREEN_LIGHT, DARK, CARD_BG, CARD_BORDER, MUTED
    BLACK, WHITE, GREEN, DARK, CARD_BG = theme.background, theme.text, theme.accent, theme.button, theme.panel
    GREEN_DARK = theme.accent
    GREEN_LIGHT = theme.text
    CARD_BORDER = theme.button
    MUTED = theme.text
    try:
        self.root.configure(bg=theme.background)
        for child in self.root.winfo_children():
            _skin_original(child, theme)
    except tk.TclError:
        pass


def _open_settings(self):
    """Open the Settings window attached to the original Routina app."""
    if not hasattr(self, "bridge"):
        self.bridge = _RoutinaBridge(self)
        self.theme = self.bridge.theme
        self._apply_theme(self.theme)
    gui.SettingsWindow(self.bridge)


def _toggle_task_with_reward(self, task_id):
    """Preserve the original task toggle and award a deduplicated completion token."""
    row = self.db.execute("SELECT completed FROM tasks WHERE id=?", (task_id,)).fetchone()
    was_completed = bool(row["completed"]) if row else False
    result = _base_toggle_task(self, task_id)
    if row and not was_completed:
        completion_date = date.today().isoformat()
        with self.bridge.db.tx() as conn:
            conn.execute("INSERT OR IGNORE INTO task_completions(task_id,completion_date) VALUES(?,?)",
                         (task_id, completion_date))
        game_hooks.on_activity_completed("task", task_id, datetime.now().isoformat(timespec="seconds"))
        _update_badge(self)
    return result


def _quit_integrated(self):
    """Close game services and then use the original Routina shutdown path."""
    if hasattr(self, "bridge"):
        self.bridge.close()
    _base_quit(self)


RoutinaApp.__init__ = _integrated_init
