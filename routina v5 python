def h2r(h):
    """Hex string to an RGB tuple."""
    return int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)


def r2h(c):
    """RGB tuple to a hex string."""
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(v))) for v in c)


def mixh(a, b, t):
    """Blend hex colour a toward b by t."""
    ra, rb = h2r(a), h2r(b)
