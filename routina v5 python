        if not fc.valid_activity_name(name):
            messagebox.showerror("Invalid task name", "Use alphabetic characters and spaces only.", parent=self.root)
            return
        with self.db:
            self.db.execute("INSERT INTO tasks(name, completed, created_at) VALUES(?,0,?)",
